# Local overrides for the aipass bridge (Layer 3).
# Precedence: Doppler → Cloudflare wrangler [vars] → this file → defaults.
# NEVER put secret token values here — secrets belong in Doppler or
# Cloudflare Worker secrets (see docs/CONFIGURATION.md).

#PORT=8787
#HOST=127.0.0.1
#MODEL=gemini-3.1-flash-lite
#MODELS=gemini-3.1-flash-lite,claude-sonnet-5@default
#TOOL_VISIBILITY=reasoning
#IDLE_TIMEOUT_MS=180000
#MEDIA_TIMEOUT_MS=900000
#KEEPALIVE_MS=15000
#CORS_ORIGIN=
#ADMIN=0
#ALLOWED_HOSTS=
